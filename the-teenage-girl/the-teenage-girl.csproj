<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>the_teenage_girl</RootNamespace>
        <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" />
        <PackageReference Include="Markdig" Version="1.1.3" />
        <PackageReference Include="YamlDotNet" Version="17.1.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="Components\Pages\Posts\Media\boys004.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="wwwroot\src\output.css" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="Components\Widgets\LatestPost.razor" />
        <_ContentIncludedByDefault Remove="wwwroot\js\output.css" />
        <_ContentIncludedByDefault Remove="wwwroot\js\tailwind.config.js" />
    </ItemGroup>

    <Target Name="GenerateManifests" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <PostFiles Include="wwwroot/posts/*.md" />
            <MovieFiles Include="wwwroot/movies/*.md" />
        </ItemGroup>

        <PropertyGroup>
            <PostSlugsJson>[@(PostFiles->'"%(Filename)"', ',')]</PostSlugsJson>
            <MovieSlugsJson>[@(MovieFiles->'"%(Filename)"', ',')]</MovieSlugsJson>
        </PropertyGroup>

        <WriteLinesToFile
                File="wwwroot/posts/manifest.json"
                Lines="$(PostSlugsJson)"
                Overwrite="true" />

        <WriteLinesToFile
                File="wwwroot/movies/manifest.json"
                Lines="$(MovieSlugsJson)"
                Overwrite="true" />
    </Target>

</Project>