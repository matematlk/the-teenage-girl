@page "/Movies"
@implements IAsyncDisposable
@using the_teenage_girl.Components.Shared
@inject MovieService MovieService
@inject IJSRuntime js

<PageTitle>Movies</PageTitle>

<div class="ticket-page">
    <div class="movie-list">
        @foreach (var movie in _allMovies)
        {
            <MovieCard Movie="movie" @key="movie.Slug" />
        }
    </div>
</div>

@code {
    private List<MovieMetaData> _allMovies = new();

    protected override async Task OnInitializedAsync()
    {
        _allMovies = await MovieService.GetAllMoviesAsync();
    }

	protected override async Task OnAfterRenderAsync(bool firstRender) 
	{
		if (firstRender)
		{
			await js.InvokeVoidAsync("setMovieTheme", true);
		}
    }

	public async ValueTask DisposeAsync()
    {
        await js.InvokeVoidAsync("setMovieTheme", false);
    }
    
}