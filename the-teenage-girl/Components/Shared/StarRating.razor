<div class="stars">
    @for (int i = 1; i <= 5; i++)
    {
        if (Rating >= i)
        {
            <span class="@(MoviePage ? "yellow":"") star full">★</span>
        } 
        else if (Rating >= i - 0.5f)
        {
            <span class="@(MoviePage ? "yellow":"") star half">★</span>
        }
        else
        {
            <span class="@(MoviePage ? "brown":"") star empty">★</span>  
        }
    }
</div>

@code {
    [Parameter] public float Rating { get; set; }
    [Parameter] public bool MoviePage { get; set; } = false;
}