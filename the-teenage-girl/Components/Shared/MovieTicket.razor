@using the_teenage_girl.Components.Pages

<div class="ticket-content shadow">
    <div class="ticket-title">TICKET</div>
    <p style="text-align: center;">/ /</p>
    <div class="category-ticker">
        @foreach (var cat in categories)
        {
            @if (cat == @Movie.Genre)
            {
                <p style="font-weight: bold;">@Movie.Genre</p>
            }
            else
            {
                <p>@cat</p>
            }
        }
    </div>
    <div class="description-section justify-start flex flex-col ml-1 w-[80em] content-start">
        <p class="sub-title pt-3">Title : </p>
        <p class="movie-title justify-self-center font-bold pt-1">@Movie.Title</p>
        <p class="mt-1"><i>@Movie.Review</i></p>
        <div class="rating-section flex flex-row pt-7 align-center content-between">
            <p class="sub-title">Rating :  </p>
            <StarRating Rating="@Movie.Rating"/>
        </div>
    </div>
    <div class="ticket-barcode">
        <img src="images/barcode.png" alt="this is a barcode"/>
    </div>
    
</div>

@code {
    [Parameter] public MovieMetaData Movie { get; set; } = null!;

    private string[] categories = new string[5] {"sf", "comedy", "romcom", "drama", "other"};
    
}